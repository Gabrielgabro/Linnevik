# Kopiera till .env.local och fyll i. Committa aldrig .env.local.

# ---------------------------------------------------------------------------
# E-post (SMTP)
#
# Linnevik skickar via sin egen leverantör, wsr.se — inte via Gmail eller
# Outlook direkt. Domänens SPF är hard fail
# (`v=spf1 mx a a:smtp.wsr.se a:smtp2.wsr.se -all`) och DMARC står på
# `p=quarantine` med strikt inpassning (`aspf=s; adkim=s`). Post från någon
# annan värd saknar godkänd SPF och en DKIM-signatur inpassad mot linnevik.se,
# och hamnar i skräpposten.
#
# MAIL_FROM MÅSTE ligga på linnevik.se — strikt inpassning tillåter inte ens en
# subdomän, och inte heller linnevik.com.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.wsr.se
SMTP_PORT=465
# Utelämna för att låta porten avgöra: 465 = implicit TLS, 587 = STARTTLS.
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@linnevik.se
# Dit kontaktformulär och provbeställningar går. Faller tillbaka på SMTP_USER.
CONTACT_EMAIL_TO=info@linnevik.se
# Mottagare för prisbevakningens larm. Faller tillbaka på CONTACT_EMAIL_TO.
# PRICE_WATCH_TO=

# Används som bas för länkar i mejlen.
NEXT_PUBLIC_SITE_URL=https://linnevik.se

# ---------------------------------------------------------------------------
# Kundinloggning via e-postlänk (lib/customerSession.ts, lib/magicLink.ts)
#
# Ersätter Shopifys kundinloggning enligt migrationsplanen. Körs parallellt
# med Shopify-inloggningen redan nu; blir den aktiva vägen först vid
# nedstängningen.
#
# Egen hemlighet, skild från ADMIN_SESSION_SECRET — ett läckt värde ska bara
# kompromettera det ena systemet, inte båda. Generera t.ex. med
# `openssl rand -base64 32`.
# ---------------------------------------------------------------------------
CUSTOMER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Ägd handel (lib/commerceConfig.ts)
#
# Den avgörande cutover-brytaren. Satt till "true" byter storefrontens korg,
# kassa och kundkonton från Shopify till Postgres/Stripe/e-postlänken — sätts
# medvetet vid själva nedstängningen, inte innan (se the_big_purge.md).
# Sweden/SEK-only tills vidare: region- och valutaväljaren döljs när den är på.
# ---------------------------------------------------------------------------
OWNED_COMMERCE_ENABLED=false
