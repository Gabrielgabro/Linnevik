# Kopiera till .env.local och fyll i. Committa aldrig .env.local.

DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Vercel sends this as Authorization: Bearer ... to both cron routes.
CRON_SECRET=

# ---------------------------------------------------------------------------
# E-post (SMTP)
#
# Linnevik skickar via sin egen leverantör, wsr.se — inte via Gmail eller
# Outlook direkt. Domänens SPF är hard fail
# (`v=spf1 mx a a:smtp.wsr.se a:smtp2.wsr.se -all`) och DMARC står på
# `p=quarantine` med strikt inpassning (`aspf=s; adkim=s`). Post från någon
# annan värd saknar godkänd SPF och en DKIM-signatur inpassad mot linnevik.se,
# och hamnar i skräpposten.
#
# MAIL_FROM MÅSTE ligga på linnevik.se — strikt inpassning tillåter inte ens en
# subdomän, och inte heller linnevik.com.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.wsr.se
SMTP_PORT=465
# Utelämna för att låta porten avgöra: 465 = implicit TLS, 587 = STARTTLS.
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@linnevik.se
# Dit kontaktformulär och provbeställningar går. Faller tillbaka på SMTP_USER.
CONTACT_EMAIL_TO=info@linnevik.se
# Mottagare för prisbevakningens larm. Faller tillbaka på CONTACT_EMAIL_TO.
# PRICE_WATCH_TO=

# Används som bas för länkar i mejlen.
NEXT_PUBLIC_SITE_URL=https://linnevik.se

# ---------------------------------------------------------------------------
# Kundinloggning via e-postlänk (lib/customerSession.ts, lib/magicLink.ts)
#
# Den enda kundinloggningen. Gamla Shopify-länkar leder tillbaka till login.
#
# Egen hemlighet, skild från ADMIN_SESSION_SECRET — ett läckt värde ska bara
# kompromettera det ena systemet, inte båda. Generera t.ex. med
# `openssl rand -base64 32`.
# ---------------------------------------------------------------------------
CUSTOMER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Ägd handel (lib/commerceConfig.ts)
#
# Kill-switch för korg och kassa. Storefronten har ingen Shopify-fallback:
# false ger 503 i handels-API:t, true öppnar Postgres/Stripe-flödet.
# Sweden/SEK-only tills vidare.
# ---------------------------------------------------------------------------
OWNED_COMMERCE_ENABLED=false
# Hur länge spårat lager reserveras medan Stripe Checkout är öppet. 31–1440.
CHECKOUT_RESERVATION_MINUTES=45

# ---------------------------------------------------------------------------
# Moms (lib/vat.ts)
#
# Sajten visar priser exklusive moms och kassan lägger på den. Två vägar, som
# inte går att kombinera i Stripe:
#
#   1. En uttrycklig svensk momssats — standardläget, och det som gäller så
#      länge flaggan nedan är osatt.
#   2. Stripe Tax (`automatic_tax`), som klarar omvänd skattskyldighet mot ett
#      giltigt VAT-nummer och andra länders satser.
#
# Sätt STRIPE_TAX_REGISTRATION_CONFIRMED=true först när Sverige står som
# **Collecting** under Settings → Tax → Registrations i Stripe. Stripe Tax utan
# registrering räknar fram 0 % och tar tyst in ingen moms alls — kassan
# kontrollerar därför registreringen mot Stripe och vägrar starta om den
# saknas, men flaggan ska ändå inte sättas på gissning.
# STRIPE_TAX_REGISTRATION_CONFIRMED=true

# Normalsatsen i procent. Utelämnad = 25. Orimliga värden ignoreras.
# VAT_PERCENT=25
